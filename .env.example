# ─────────────────────────────────────────────────────────────
# AgriSaathi Edge AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to version control.
# ─────────────────────────────────────────────────────────────

# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model names (defaults are gemini-2.5-flash for both)
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Serial port where the ESP32 is connected (Windows: COM5, Linux: /dev/ttyUSB0)
SERIAL_PORT=COM5
SERIAL_BAUD=115200

# FastAPI server binding
HOST=0.0.0.0
PORT=8080

# Max chat history messages kept per session (older messages are trimmed)
CHAT_HISTORY_MAX=20

# Display label for the field location shown on the dashboard
FIELD_NAME=Seethariguda Field 01 (Telangana)
